# Empty uses same-origin /api (Vite proxy locally, nginx in Docker).
VITE_API_URL=
# Use a provider appropriate to your deployment; these values are public build settings.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
